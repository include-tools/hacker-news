{
  "name": "users.get hydrates the first N submissions in order",
  "tool": "users.get",
  "args": { "username": "jl", "include_recent": 2 },
  "cassette": "users.get.hydrate",
  "expect": {
    "contains": ["Find Your People", "Delicious", "\"submitted_count\":851", "\"submissions_requested\":2", "\"submissions_returned\":2", "\"truncated\":true"],
    "calls": [
      { "method": "GET", "host": "hacker-news.firebaseio.com", "path": "/v0/user/jl.json", "headers": { "Authorization": "" } },
      { "method": "GET", "host": "hacker-news.firebaseio.com", "path": "/v0/item/44074017.json", "headers": { "Authorization": "" } },
      { "method": "GET", "host": "hacker-news.firebaseio.com", "path": "/v0/item/35686379.json", "headers": { "Authorization": "" } }
    ]
  }
}
