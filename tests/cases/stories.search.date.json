{
  "name": "stories.search can sort by newest-first date",
  "tool": "stories.search",
  "args": { "sort": "date", "limit": 1 },
  "cassette": "stories.search.date",
  "expect": {
    "contains": ["\"sort\":\"date\"", "\"hits_returned\":1", "\"hits_per_page\":1", "\"tags\":[\"story\"]", "Date("],
    "calls": [
      { "method": "GET", "host": "hn.algolia.com", "path": "/api/v1/search_by_date", "headers": { "Authorization": "" } }
    ]
  }
}
