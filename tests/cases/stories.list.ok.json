{
  "name": "stories.list returns bounded top stories in order",
  "tool": "stories.list",
  "args": { "kind": "top", "limit": 2 },
  "cassette": "stories.list.ok",
  "expect": {
    "contains": [
      "AI agent bankrupted their operator",
      "If you are asking for human attention",
      "\"ids_selected\":2",
      "\"stories_returned\":2",
      "\"truncated\":true"
    ],
    "calls": [
      { "method": "GET", "host": "hacker-news.firebaseio.com", "path": "/v0/topstories.json", "headers": { "Authorization": "" } },
      { "method": "GET", "host": "hacker-news.firebaseio.com", "path": "/v0/item/48500012.json", "headers": { "Authorization": "" } },
      { "method": "GET", "host": "hacker-news.firebaseio.com", "path": "/v0/item/48497609.json", "headers": { "Authorization": "" } }
    ]
  }
}
