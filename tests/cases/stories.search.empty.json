{
  "name": "stories.search returns empty Algolia result pages",
  "tool": "stories.search",
  "args": { "limit": 2, "min_points": 999999999 },
  "cassette": "stories.search.empty",
  "expect": {
    "contains": ["\"hits\":[]", "\"hits_returned\":0", "\"nb_hits\":0", "\"nb_pages\":0", "\"numeric_filters\":[\"points>=999999999\"]"],
    "calls": [
      { "method": "GET", "host": "hn.algolia.com", "path": "/api/v1/search", "headers": { "Authorization": "" } }
    ]
  }
}
