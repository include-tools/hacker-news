{
  "name": "stories.list routes kind=job to the jobstories feed",
  "tool": "stories.list",
  "args": { "kind": "job", "limit": 1 },
  "cassette": "stories.list.job",
  "expect": {
    "contains": ["Emerge Career (YC S22) Is Hiring a Founding Growth Marketer", "\"kind\":\"job\"", "\"type\":\"job\"", "\"stories_returned\":1"],
    "calls": [
      { "method": "GET", "host": "hacker-news.firebaseio.com", "path": "/v0/jobstories.json", "headers": { "Authorization": "" } },
      { "method": "GET", "host": "hacker-news.firebaseio.com", "path": "/v0/item/48459968.json", "headers": { "Authorization": "" } }
    ]
  }
}
